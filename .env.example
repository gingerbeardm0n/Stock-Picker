# Alpaca API Credentials (Paper Trading)
# Get your free API keys at: https://alpaca.markets/
# Sign up for a paper trading account (no real money required)

ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Finnhub API Key (free tier — get at https://finnhub.io)
# Used for float and market cap data (run database/fetch_fundamentals.py weekly)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Marketaux API Key (free tier — 100 req/day, get at https://www.marketaux.com)
# Used as second news source for small-cap catalyst detection
MARKETAUX_API_KEY=your_marketaux_api_key_here
