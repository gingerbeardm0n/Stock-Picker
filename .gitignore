# Project-specific

# Optimization & Analysis Artifacts (keep locally, don't commit to GitHub)
# NOTE: gitignore does NOT support trailing inline comments — keep comments on their own lines.
# SQLite optimizer databases (large, keep as local backup)
archive/optunaDBfiles/
# Generated analysis outputs (regenerated on demand)
research/analysis/outputs/
# Old analysis outputs location
analysis/*.csv
# DB audit CSVs (regenerable)
database/audit_reports/
# Optimizer trade detail exports
optimizer/*.csv

# Research data artifacts (cache, temp files)
research/optimizer/**/*.csv
research/optimizer/logs/
# Optimizer scratch data / ablation outputs / cache
research/optimizer/data/
research/optimizer/ablation/
research/optimizer/cache/
# Optimizer run logs
*_log.txt
data/cache/

# Backfill progress files (regenerable run-state)
*_progress_*.json
*_progress.json

# Live trading logs (keep locally, don't commit)
production/logs/
# Live data stream captures
production/data/stream/

# SOPS decrypted env (local only — never commit plaintext secrets)
production/.env.render.dec

# Crash dumps + junk
*.stackdump

# Playwright MCP artifacts
.playwright-mcp/

